# Environment-specific overrides for a "dev" Terraform workspace.
#
# Usage:
#   terraform workspace new dev        # once, first time
#   terraform workspace select dev     # every time after
#   cp environments/dev.tfvars.example environments/dev.tfvars   # gitignored, fill in real values
#   terraform apply -var-file=terraform.tfvars -var-file=environments/dev.tfvars
#
# Only override what actually differs per environment here -- everything
# else (domain, github_repo, alert_email, ...) stays in the shared
# terraform.tfvars generated by scripts/configure.py. Merge order means the
# LAST -var-file wins on any key present in both, so put the base file first.
#
# NOTE: this only isolates Terraform *state* per workspace (see versions.tf's
# backend block). Resource names throughout this project (EKS cluster name,
# RDS identifier, IAM role names, etc.) are still hardcoded to a
# "bookstore-*" prefix in most modules, not derived from terraform.workspace
# or var.environment -- running two workspaces against the SAME AWS account
# will collide on real resource names, not just state. Safe today because
# only one environment has ever actually been deployed. Parameterizing every
# hardcoded name by environment is real, separate work -- see
# docs/FUTURE_IMPROVEMENTS.md gap #16 -- not something this file alone fixes.

environment = "dev"

# Cheaper instance types / smaller footprint for a non-prod environment:
# node_instance_type = "t3.small"
# node_desired_size  = 1
# node_max_size      = 2

# Lock down to your own IP instead of the 0.0.0.0/0 demo default:
# monitoring_admin_cidr = ["203.0.113.0/32"]
